{
  "name": "email-native-remittance",
  "version": "1.0.1",
  "description": "Email-native crypto remittance with ZK identity gate on Celo",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "build": "node build.js",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "jest",
    "test:coverage": "jest --coverage --passWithNoTests",
    "lint": "eslint src --ext .ts"
  },
  "keywords": [
    "celo",
    "remittance",
    "zk",
    "blockchain",
    "email",
    "escrow",
    "finance",
    "web3"
  ],
  "security": {
    "vulnerabilities": {
      "total": 65,
      "critical": 2,
      "high": 12,
      "moderate": 33,
      "low": 18
    },
    "strategy": "defense-in-depth",
    "isolation": {
      "blockchain": "src/services/celoService.ts",
      "verification": "src/services/selfVerification.service.ts",
      "development": "devDependencies only"
    },
    "controls": [
      "input-validation",
      "rate-limiting",
      "error-handling",
      "monitoring"
    ]
  },
  "author": "Titan",
  "license": "MIT",
  "dependencies": {
    "@celo/contractkit": "^10.0.3",
    "@mandate.md/sdk": "^0.3.1",
    "@selfxyz/core": "^1.2.0-beta.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/nodemailer": "^7.0.11",
    "better-sqlite3": "^12.10.0",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "ethers": "^6.16.0",
    "express": "^4.22.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^8.0.10",
    "resend": "^6.12.4",
    "uuid": "^9.0.1",
    "viem": "^2.51.3",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@nomicfoundation/hardhat-toolbox": "^7.0.0",
    "@playwright/test": "^1.60.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.41",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "babel-jest": "^30.4.1",
    "esbuild": "^0.28.0",
    "eslint": "^10.4.1",
    "hardhat": "^3.7.0",
    "jest": "^30.4.2",
    "npm-check-updates": "^22.2.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
