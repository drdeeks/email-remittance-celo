# ─── CORE SERVER CONFIG ───
PORT=3001
NODE_ENV=development
BASE_URL=http://localhost:3000
DATABASE_URL=file:./remittance.db

# ─── BLOCKCHAIN (REQUIRED) ───
# Server wallet that handles escrow sweeps and premium payouts
WALLET_PRIVATE_KEY=0x...
SERVER_WALLET_ADDRESS=0x...

# RPC URLs
CELO_RPC_URL=https://forno.celo.org
BASE_RPC_URL=https://mainnet.base.org
MONAD_RPC_URL=https://rpc.monad.xyz
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# ─── EMAIL (REQUIRED) ───
RESEND_API_KEY=re_...
SENDER_EMAIL=remittance@yourdomain.com

# ─── IDENTITY & VERIFICATION ───
# self.xyz (V2)
SELF_STAGING=true
SELF_APP_ID=...
SELF_SECRET=...

# World ID
WORLD_ID_APP_ID=app_...
WORLD_ID_ACTION=claim-remittance

# ─── OFFRAMP & LIQUIDITY ───
# Uniswap Trading API (Optional, falls back to public router)
UNISWAP_API_KEY=...

# Gift Cards (Optional, falls back to demo mode)
TANGO_CARD_API_KEY=...
RELOADLY_API_KEY=...

# ─── FRONTEND (REQUIRED) ───
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_CHAIN_ID=84532
NEXT_PUBLIC_ONCHAINKIT_PROJECT_ID=...
NEXT_PUBLIC_WC_PROJECT_ID=...