# =============================================
# Email Remittance Pro - Environment Configuration
# =============================================

# ======================
# Core Configuration
# ======================
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# ======================
# Database Configuration
# ======================
DATABASE_URL=sqlite:./remittance.db

# ======================
# Celo Network Configuration
# ======================
CELO_PROVIDER_URL=https://forno.celo.org
WALLET_PRIVATE_KEY=your_wallet_private_key_here  # Required
CELO_STABLECOIN_ADDRESS=0x765DE816845861e75A25fCA122bb6898B8B1282a
CELO_CONTRACT_ADDRESS=

# ======================
# Fee Configuration
# ======================
PLATFORM_FEE_PERCENTAGE=1.5  # 1.5% fee on all successful claims
STORAGE_FEE_PERCENTAGE=1.5  # 1.5% fee on unclaimed remittances

# ======================
# Uniswap & LI.FI Configuration
# ======================
UNISWAP_API_KEY=your_uniswap_api_key_here  # Required for token swaps
LI_FI_API_KEY=your_lifi_api_key_here  # Required for cross-chain bridging

# ======================
# Self Protocol Configuration (Required for Identity Verification)
# ======================
# Contract addresses for different chains
BASE_SELF_CONTRACT=0x10079Fa97E739Fd05Ddc5C7cD11951aEF566b7e0  # Required
MONAD_SELF_CONTRACT=0x7BC66eD8285b51F84D170F158aD162cA144F32c1  # Required
CELO_SELF_CONTRACT=0x10079Fa97E739Fd05Ddc5C7cD11951aEF566b7e0  # Required

# Attester configuration
SELF_ATTESTER_ADDRESS=0x38be03139523EE998952D21110115f23AE54b1f7  # Required

# API configuration
SELF_APP_ID=your_self_app_id_here  # Required
SELF_APP_SECRET=your_self_app_secret_here  # Required
SELF_API_URL=https://api.self.xyz/v1  # Optional (default: https://api.self.xyz/v1)
SELF_API_TIMEOUT=10000  # Optional (default: 10000)

# Verification settings
DEFAULT_REQUIRE_AUTH=false  # Optional (default: false) - Whether recipient verification is required by default
MIN_AGE=18  # Optional (default: 18) - Minimum age for verification
HIGH_VALUE_THRESHOLD=100  # Optional (default: 100) - Threshold for high-value transactions

# Monitoring
SELF_MONITORING_ENABLED=true  # Optional (default: true) - Enable Self Protocol monitoring
SELF_ALERT_THRESHOLD=5  # Optional (default: 5) - Number of failures before alert

# Rollback configuration
SELF_ROLLBACK_ENABLED=true  # Optional (default: true) - Enable rollback for failed transactions
SELF_MAX_RETRIES=3  # Optional (default: 3) - Maximum retry attempts

# Testing mode
SELF_STAGING=false  # Optional (default: false) - Enable staging mode for testing

# ======================
# Email Configuration (Optional)
# ======================
RESEND_API_KEY=your_resend_api_key_here  # Required for email notifications
DEFAULT_FROM_EMAIL=no-reply@yourdomain.com

# ======================
# Security Configuration
# ======================
SESSION_SECRET=your_session_secret_here
RATE_LIMIT_WINDOW_MS=15 * 60 * 1000  # 15 minutes
RATE_LIMIT_MAX=100  # Max requests per window

# ======================
# Deployment Configuration
# ======================
DEPLOYMENT_ENV=production
RENDER_EXTERNAL_URL=https://yourapp.onrender.com  # For Render deployments
CLOUDFLARE_PAGES_URL=https://yourapp.pages.dev  # For Cloudflare Pages deployments