# Dependency Management Configuration

# Production dependencies only (no devDependencies in production)
production=false

# Prefer stable versions
audit-level=moderate
engine-strict=true

# Security settings
save-exact=true
ignore-scripts=false

# Vulnerability management
# Note: Some vulnerabilities are inherited from Celo and Self Protocol dependencies
# These are required for core functionality and are isolated to blockchain operations
# See DEPENDENCY_RISKS.md for detailed risk assessment